10 CLEAR:RANDOMIZE VAL(RIGHT$(TIME$,2)):SCREEN 0,0,0:WIDTH 40:FOR I=1 TO 10:KEY I,"":NEXT I:KEY OFF:CLS:LOCATE 7,5:PRINT"*** ARTILLERY SIMULATOR ***":INPUT"DO YOU WANT SOUND";S$:IF S$="Y" THEN S=1 ELSE S=0
15 GOSUB 340
20 LOCATE 22,1:PRINT"PRESS ANY KEY TO CONTINUE"
30 SX$=INKEY$:IF SX$="" THEN 30
31 WIDTH 40
35 CLS:P1=99:DIM YY(280):PI=3.141592654#/180:SCREEN 1:COLOR 9,1:CLS
40 P1=-P1:P=INT(RND(1)*20+139):FOR I=1 TO 112:LINE(I,P)-(I,159),3:YY(I)=P:NEXT:HG=INT(RND(1)*50+25):FOR I=113 TO 152:HX=SIN(((I-112)*4.5+180)*PI)*HG:YY(I)=HX+P:LINE (I,HX+P)-(I,159):NEXT
50 FOR I=153 TO 279:LINE (I,P)-(I,159),3:YY(I)=P:NEXT:WIND=INT(RND(1)*10):IF RND(1)*100>50 THEN WIND=-WIND
60 LINE (112,10)-(152,10):IF WIND>0 THEN LINE (112,10)-(125,5)
70 LOCATE 5,15:PRINT"WIND :";ABS(WIND):IF WIND<0 THEN LINE (152,10)-(139,5)
80 B1=INT(RND(1)*20+50)-5*WIND:B2=INT(RND(1)*20)+200+WIND*5:LINE (B1-3,P)-(B1-3,P-5):LINE-(B1+3,P-5):LINE-(B1+3,P):LINE-(B1-3,P-5):LINE (B1-3,P)-(B1+3,P-5)
90 LINE (B2-3,P)-(B2-3,P-5):LINE-(B2+3,P-5):LINE-(B2+3,P):LINE-(B2-3,P-5):LINE (B2-3,P)-(B2+3,P-5):IF P1=99 THEN 250
100 KEY ON:KEY OFF:LOCATE 25,1:INPUT;"#1: ANGLE,FORCE";AN,BG:BG=BG*10:Q=1000
110 IF P1=-99 THEN PX=B1
120 IF P1=99 THEN PX=B2
130 LOCATE 5,15:PRINT"WIND :";ABS(WIND):I=0
140 I=I+.1:X=BG*I*COS(AN*PI):IF P1=-99 THEN X=X+B1
150 IF P1=99 THEN X=B2+X
160 Y=BG*I*SIN(AN*PI)-16*I^2:X=X-WIND*I^2:IF P1=99 THEN Y=BG*I*(-SIN(AN*PI))-16*I^2
170 PSET (PX,PY),0:IF X<3 OR X>276 OR P-Y<0 THEN 240
180 IF YY(X)<P-Y THEN 200
190 SOUND 40,0:Q=Q-4:SOUND Q,.2*S:PSET (X,P-Y):PX=X:PY=P-Y:GOTO 140
200 IF ABS(X-B1)<3 THEN 260
210 IF ABS(X-B2)<3 THEN 270
220 IF X<3 OR X>276 THEN 240
230 FOR I=1 TO 25:BX=X-3+INT(RND(1)*6):BY=YY(BX)+INT(RND(1)*3):PSET (BX,BY),0:FOR ZA=1 TO 5:SOUND 40,.1*S:NEXT ZA:NEXT I:FOR I=X-3 TO X+3:YY(I)=YY(I)+3:NEXT
240 P1=-P1:IF P1=-99 THEN 100
250 KEY ON:KEY OFF:LOCATE 25,1:INPUT;"#2: ANGLE,FORCE";AN,BG:BG=BG*10:AN=AN+180:PY=P-5:GOTO 110
260 GX=B1:GOTO 280
270 GX=B2
280 FOR I=GX-10 TO GX+10 STEP 2:LINE ( I,P-10)-(GX,P):FOR J=1 TO INT(RND (1)*5)+5:NEXT:NEXT:FOR I=1 TO 100:SOUND 40,0:SOUND 37,.1*S:NEXT:SCREEN 0:CLS:PRINT:PRINT:PRINT:PRINT:PRINT"DO YOU WANT TO PLAY AGAIN":PRINT"(Y FOR YES, N FOR NO)=>";
290 Z$=INKEY$:IF Z$="" THEN 290
300 IF Z$="Y" THEN 10
310 IF Z$<>"N" THEN 290
320 LOCATE 8,8:PRINT"* * * T H E   E N D * * *":FOR I=1 TO 1000:NEXT I:KEY 1,"LIST ":KEY 2,"RUN"+CHR$(13):KEY 3,"LOAD"+CHR$(34):KEY 5,"CONT"+CHR$(13):KEY 6,","+CHR$(34)+"LPT1"+CHR$(13):KEY 4,"SAVE"+CHR$(34)
330 KEY 7,"TRON"+CHR$(13):KEY 8,"TROFF"+CHR$(13):KEY 9,"KEY ":KEY 10,"SCREEN 0,0,0"+CHR$(13):WIDTH 80:CLS:END
340 CLS:WIDTH 80:PRINT" THIS IS AN ARTILLERY SIMULATOR. THE OBJECT OF THIS GAME IS TO DESTROY"
350 PRINT "YOUR OPPONENT BEFORE HE DESTROYS YOU. TO ACHIEVE THIS GOAL YOU MUST OVER-"
