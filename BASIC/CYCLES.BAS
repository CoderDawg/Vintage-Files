10 KEY OFF:CLS:CLEAR:SCREEN 0:WIDTH 80:LIVES1=5:LIVES2=5
20 DEF SEG=0:POKE &H417,&H70
30 GOSUB 730
40 INPUT"WOULD YOU LIKE SOUND Y/N";A$:IF A$="Y" THEN S=1
50 CLS:LINE INPUT"PLAYER #1'S NAME: ";PLAY1$:LINE INPUT"PLAYER #2'S NAME: ";PLAY2$
60 DEF FNA(X)=INT(RND(1)*X)+1
70 SCREEN 2
80 RANDOMIZE VAL(RIGHT$(TIME$,2))+INT(RND(1)*4000)
90 LINE (10,20)-(639,189),,B
100 LINE (330,0)-(330,20)
110 A$=INKEY$:IF A$<>"" THEN 110
120 U=INT(RND*4)+1:V=INT(RND*4)+1
130 SCOUNT=0
140 LOCATE 1,15:PRINT PLAY2$:LOCATE 1,60:PRINT PLAY1$
150 LOCATE 2,1:PRINT"SCORE=";SC1;"  LIVES LEFT=";LIVES1
160 LOCATE 2,50:PRINT"SCORE=";SC2;"  LIVES LEFT=";LIVES2
170 A=FNA(300)+30:B=FNA(165)+20:X=FNA(290)+335:Y=FNA(165)+20
180 PSET(A,B):PSET(X,Y)
190 A$=INKEY$
200 IF A$="s" OR A$="S" THEN U=1
210 IF A$="E" OR A$="e" THEN U=2
220 IF A$="F" OR A$="f" THEN U=3
230 IF A$="c" OR A$="C" THEN U=4
240 IF A$="4" THEN V=1
250 IF A$="8" THEN V=2
260 IF A$="6" THEN V=3
270 IF A$="2" THEN V=4
280 ON U GOSUB 310,390,470,550
290 ON V GOSUB 350,430,510,590
300 GOTO 190
310 A=A-2:IF A<10 THEN GOTO 630
320 SCOUNT=SCOUNT+2
330 IF POINT (A,B)<>0 OR POINT (A+1,B)<>0 THEN 630
340 PSET (A,B):RETURN
350 X=X-2:IF X<10 THEN GOTO 680
360 SCOUNT=SCOUNT+2
370 IF POINT (X,Y)<>0 OR POINT (X+1,Y)<>0 THEN 680
380 PSET (X,Y):RETURN
390 B=B-1:IF B<20 THEN GOTO 630
400 SCOUNT=SCOUNT+2
410 IF POINT (A,B)<>0 THEN 630
420 PSET(A,B):RETURN
430 Y=Y-1:IF Y<20 THEN GOTO 680
440 SCOUNT=SCOUNT+2
450 IF POINT (X,Y)<>0 THEN 680
460 PSET(X,Y):RETURN
470 A=A+2:IF A>639 THEN GOTO 630
480 SCOUNT=SCOUNT+2
490 IF POINT (A,B)<>0 OR POINT (A-1,B)<>0 THEN 630
500 PSET (A,B):RETURN
510 X=X+2:IF X>639 THEN GOTO 680
520 SCOUNT=SCOUNT+2
530 IF POINT (X,Y)<>0 OR POINT (X-1,Y)<>0 THEN 680
540 PSET (X,Y):RETURN
550 B=B+1:IF B>189 THEN GOTO 630
560 SCOUNT=SCOUNT+2
570 IF POINT (A,B)<>0 THEN 630
580 PSET(A,B):RETURN
590 Y=Y+1:IF Y>189 THEN GOTO 680
600 SCOUNT=SCOUNT+2
610 IF POINT (X,Y)<>0 THEN 680
620 PSET(X,Y):RETURN
630 FOR AA=200 TO 650:SOUND AA,.001*S:NEXT AA:SOUND 40,0
640 SC2=SC2+SCOUNT
650 LIVES1=LIVES1-1
660 IF LIVES1=<0 THEN SCREEN 0:PRINT "GAME OVER":PRINT "FINAL SCORE:":PRINT PLAY1$" =";SC1:PRINT PLAY2$" =";SC2:END
670 CLS:GOTO 90
680 FOR AA=200 TO 650:SOUND AA,.001*S:NEXT AA:SOUND 40,0
690 SC1=SC1+SCOUNT
700 LIVES2=LIVES2-1
710 IF LIVES2=<0 THEN SCREEN 0:PRINT "GAME OVER":PRINT "FINAL SCORE:":PRINT PLAY1$" =";SC1:PRINT PLAY2$" =";SC2:END
720 CLS:GOTO 90
730 CLS:PRINT "WOULD YOU LIKE INSTRUCTIONS (Y/N)";
740 QQ$=INPUT$(1):IF QQ$="N" OR QQ$="n" THEN RETURN
750 IF QQ$<>"Y" AND QQ$<>"y" THEN 740
760 CLS:PRINT"THIS IS A TWO PLAYER GAME. EACH PLAYER CONTROLS ONE CYCLE."
770 PRINT"THE OBJECT OF THE GAME IS TO AVOID RUNNING INTO THE WALLS LEFT"
780 PRINT"BEHIND BY THE CYCLES. THE LONGER YOU AVOID RUNNING INTO THE WALLS"
790 PRINT"THE MORE POINTS YOU CAN GET. THE CONTROLS ARE AS FOLLOWS:"
800 PRINT"RIGHT HAND PLAYER-ARROW KEYS."
810 PRINT"LEFT HAND PLAYER-THE DIAMOND FORMED BY THE KEYS E,S,F,C"
820 PRINT"HIT A KEY"
830 QQ$=INPUT$(1):CLS:RETURN