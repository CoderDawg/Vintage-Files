10 RESTORE
20 CLS
30 '***** Example of bubble sort and plotting *****
40 KEY OFF
50 CNT% = 22
60 SWP% = 0
70 EXC% = 0
80 PASS = 0
90 DIM X(CNT%),Y(CNT%)
100 '** FILL ARRAY
110 FOR LCV = 1 TO CNT%
120   READ XDTA
130   X(LCV) = XDTA
140 NEXT
150 '** FILL ARRAY
160 FOR LCV = 1 TO CNT%
170   READ YDTA
180   Y(LCV) = YDTA
190 NEXT
200 '
210 '** PRINT UNSORTED ARRAY
220 PRINT "UNSORTED ARRAY:  "
230 FOR LCV =  1 TO CNT%
240   PRINT X(LCV);
250 NEXT
260 PRINT
270 FOR LCV =  1 TO CNT%
280   PRINT Y(LCV);
290 NEXT
300 PRINT
310 FOR LCV1 = 1 TO CNT% - 1
320   FOR LCV2 = LCV1 + 1  TO CNT%
330     IF X(LCV1) > X(LCV2) THEN GOSUB 510
340     IF Y(LCV1) > Y(LCV2) THEN GOSUB 560
350     PASS = PASS + 1
360   NEXT
370 NEXT
380 PRINT : PRINT "SORTED ARRAY:  "
390 FOR LCV =  1 TO CNT%
400   PRINT X(LCV);
410 NEXT
420 PRINT
430 FOR LCV =  1 TO CNT%
440   PRINT Y(LCV);
450 NEXT
460 PRINT
470 PRINT : PRINT "#COMPARISONS:  ";SWP%;"  #EXCHANGES:  ";EXC%;"  #PASSES:  ";PASS
480 '
490 '
500 END
510  ' TEMP = X(LCV1)
520  ' X(LCV1) = X(LCV2)
530  ' X(LCV2) = TEMP
540 SWP% = SWP% + 1
545 SWAP X(LCV2),X(LCV1)
550 RETURN
560  ' TEMP = Y(LCV1)
570   ' Y(LCV1) = Y(LCV2)
580   ' Y (LCV2) = TEMP
590 SWP% = SWP% + 1
595 SWAP Y(LCV2),Y(LCV1)
600 RETURN
610 DATA  03,12,05,18,30,07,01,17,20,10,25,15,28,22,09,02,29,15,26,23,0,0
620 DATA  90,84,98,50,10,90,88,36,50,70,02,20,04,12,56,66,26,60,18,18,0,0
630 END