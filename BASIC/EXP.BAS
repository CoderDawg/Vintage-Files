10 KEY OFF
20 D = 60 : HEAD = 0 : DRIVE = 0 : SECTOR = 0 : TRACK = 0
30 TIME$ = "0" : F$ = TIME$
40 CLS
50 F$ =TIME$
60 IF D <= VAL(RIGHT$(F$,2)) THEN GOTO 340
70 F$ = TIME$
80  TRK = 0
90  SEC = 1
100 SIDE = 0
110 REM
120 F$ =TIME$
130 IF D <= VAL(RIGHT$(F$,2)) THEN GOTO 340
140 LOCATE 13,30 : PRINT "ELASPED TIME:  "; : COLOR 15,0 : PRINT F$ : COLOR 7
150 LOCATE 15,30 :PRINT "SECTOR NUMBER:  ";SEC
160 LOCATE 16,30 :PRINT "TRACK NUMBER:   ";TRK
170 LOCATE 17,30 :PRINT "HEAD NUMBER:    ";SIDE
180 LOCATE 18,30 :PRINT "DRIVE:           B"
190 SIDE = SIDE + 1
200 IF SIDE <= 1 GOTO 110
205 LOCATE 15,50 : COLOR 15,0 : PRINT "1 2 3 4 5 6 7 8"
220 COLOR 0,15
230 IF SEC = 1 THEN GOTO 350
240 IF SEC = 2 THEN GOTO 360
250 IF SEC = 3 THEN GOTO 370
260 IF SEC = 4 THEN GOTO 380
270 IF SEC = 5 THEN GOTO 390
280 IF SEC = 6 THEN GOTO 400
290 IF SEC = 7 THEN GOTO 410
300 IF SEC = 8 THEN GOTO 420
305 COLOR 7
307 SEC = SEC + 1
310 IF SEC <= 8 THEN GOTO 100
320 TRK = TRK+1
330 IF TRK<=39 THEN GOTO 90
340 STOP
350 LOCATE 15,50 : PRINT "1" : COLOR 15,0
360 LOCATE 15,52 : PRINT "2" : COLOR 15,0
370 LOCATE 15,54 : PRINT "3" : COLOR 15,0
380 LOCATE 15,56 : PRINT "4" : COLOR 15,0
390 LOCATE 15,58 : PRINT "5" : COLOR 15,0
400 LOCATE 15,60 : PRINT "6" : COLOR 15,0
410 LOCATE 15,62 : PRINT "7" : COLOR 15,0
420 LOCATE 15,64 : PRINT "8" : COLOR 15,0
430 GOTO 305