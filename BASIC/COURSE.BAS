10 REM THE PROGRAM TITLE:  The Course
20 KEY OFF:COLOR 7:CLS:WIDTH 40:PRINT TAB(10);
30 PRINT ">>> THE COURSE <<<"
40 PRINT
50  PRINT "REQUIRE INSTRUCTIONS (Y/N)";
60 X$=INPUT$(1): IF X$="N" OR X$="n" THEN 210
70 CLS
80 PRINT : PRINT
90 PRINT "The course will require that you"
100 PRINT "use top notch reflexes to control"
110 PRINT "your vehicle to a distance of"
120 PRINT "10 laps.  The course will be both"
130 PRINT "straight and winding.  You will"
140 PRINT "control your vehicle with the"
150 PRINT "left and right arrow keys."
160 PRINT "The slightest contact to the"
170 PRINT "edge of the track will cause"
180 PRINT "an accident, and a hit"
190 PRINT "to your score."
200 PRINT :PRINT :PRINT "STRIKE A KEY..."
205 X$=INKEY$: IF X$="" THEN 205
210 CLS: T=1:AT=1
220 INPUT "First name of driver";D$
225 IF D$="" THEN PRINT:GOTO 220
230 PRINT D$;" strike a key to begin..."
240 X$=INKEY$:IF X$="" THEN 240
245 IF T>=2 THEN CLS:GOTO 260
250 CLS:DIM CX(26),CY(26)
255 COLOR 15,0
260 LOCATE 1,1:PRINT "Driver:  ";D$:GOSUB 1000
265 CC=0:LP=0:LL=0:HI=0:REM The Course
270 CX=1940:CY=CX+18:J=219:C=1
275 C1=CX+6:C2=C1+2:REM The Vehicle
280 KY=0:IF CX<=1 OR C1<=1 THEN 400
285 IF CC=1 THEN 420
290 DEF SEG=&HB000:POKE CX,J:POKE CY,J
295 CX(C)=CX:CY(C)=CY:REM Blank Old Course
300 CX=CX-80:CY=CY-80
305 C=C+1
310 DD=2*INT(RND*2+1)
315 KY$=INKEY$:IF LEN(KY$)=2 THEN KY=ASC(MID$(KY$,2,1))
320 IF DD=2 THEN 340
330 CX=CX+DD-2:CY=CY+DD-2:GOTO 360
340 DD=-DD
350 CX=CX+DD:CY=CY+DD
360 REM Check Movement of Vehicle
370 IF KY=75 THEN 500
380 IF KY=77 THEN 530
390 GOTO 280
400 CC=1:LP=LP+1
405 IF (LP/10)=.6 THEN LL=LL+1:LP=1
410 LOCATE 2,1:PRINT "LAPS= ";LL;
415 IF LL>=10 THEN 700 ELSE GOTO 270
420 DEF SEG =&HB000:POKE CX(C),32:POKE CY(C),32
430 POKE C1,32:POKE C2,32
440 IF C2<=156 THEN 290
450 C1=C1-80:C2=C2-80
460 POKE C1,204 : POKE C2,185: POKE C1+1,36:POKE C2+1,36
470 CL=PEEK(CL-2):CR=PEEK(C2+2)
480 IF ABS(CL+CR)<>64 THEN 600
485 GOTO 290
500 REM Vehicle Movement (left)
505 DEF SEG =&HB000:POKE C1,32:POKE C2,32:POKE C1+1,39:POKE C2 +1,39
510 C1=C1-2:C2=C2-2
520 GOTO 280
530 REM Vehicle Movement (right)
535 DEF SEG =&HB000:POKE C1,32:POKE C2,32:POKE C1+1,39:POKE C2 +1,39
540 IF C2<=84 THEN 280
550 C1=C1+2:C2=C2+2
560 GOTO 280
600 REM Hits to Vehicle
610 HI=HI+1
620 LOCATE 3,1:PRINT "HITS = ";HI;
630 GOTO 290
700 REM Finish
710 LOCATE 4,1:PRINT STRING$(40,32)
720 IF HI=0 THEN 800
730 PRINT "You didn't make the ";LL;" laps"
740 PRINT "without error.  You took a"
750 PRINT "total of ";HI;" hits...."
760 PRINT : PRINT "Try again, ";D$;
770 X$=INPUT$(1)
780 IF X$="N" OR X$="n" THEN 1100
790 AT=AT+1:PRINT :GOTO 830
800 PRINT "NOT BAD, No hits at all"
810 PRINT "think you might want to"
820 GOTO 760
830 T(T)=HI:REM Best Score
840 I=1:Z=0
850 TRON:IF T(I)<=T(T+1) THEN 8800K
860 YS=T(I):T(I)=T(I+1):T(I+1)=YS
870 Z=1
880 I=I+1:IF I>=T THEN 900
890 GOTO 850
900 IF Z=1 THEN 840
910 BS=T(1)
920 T=T+1:IF T>=5 THEN BS=T(1):T=3
930 PRINT
940 PRINT :GOTO 230
1000 REM Message
1010 IF T<=2 THEN 1040
1020 LOCATE 1,28:PRINT "BEST SCORE:  ";BS;
1030 LOCATE 2,28:PRINT "ATTEMPTS:  ";AT;
1040 RETURN
1100 REM End
1110 WIDTH 80:COLOR 7:SCREEN 0,0,0:CLEAR:CLS
1120 PRINT "End of program run..."
1130 END