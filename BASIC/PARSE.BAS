5 CLS
10 GOSUB 1390
15 INPUT IN$
20 GOTO 10
1390 QUOTE$ = "'"
1400 TRUE = -1
1410 FALSE = 0
1420 I1$ = SPACE$(1)
1430 I$ = SPACE$(255)
1450 WORDS = 0
1460 LSET I$ = IN$ : MAXL = LEN(I$)
1470 FOR SP = 1 TO MAXL
1480 LSET I1$ = MID$(I$,SP,1)
1490 IF I1$ <> SPACE$(1) GOTO 1600
1500 NEXT
1540 PRINT "FOUND";WORDS;"WORDS"
1550 FOR I = 1 TO WORDS
1560 PRINT WORDS$(I)
1570 NEXT
1580 RETURN
1600 D.Q = (I1$ = QUOTE$)
1610 LSET I$ = MID$(I$,SP) : MAXL = MAXL- SP+1-D.Q
1620 IF NOT D.Q THEN GOTO 1670
1640 SP = INSTR(2,I$,QUOTE$)+1 : IF SP = 1 THEN SP =MAXL+1
1650 GOTO 1700
1670 SP1 = INSTR(I$," ") : IF SP1 = 0 THEN SP1 = MAXL + 1
1680 SP2 = INSTR(I$,",") : IF SP2 = 0 THEN SP2 = MAXL + 1
1690 IF SP1 < SP2 THEN SP = SP1 ELSE SP = SP2
1700 ' *** - GOT A WORD - ***
1710 WORDS = WORDS + 1
1720 WORDS$(WORDS) = LEFT$(I$,SP-1)
1730 LSET I$ = MID$(I$,SP) : MAXL = MAXL-SP+D.Q
1740 D.Q = FALSE
1750 GOTO 1480