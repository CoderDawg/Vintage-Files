10 CLS:SCREEN 0:WIDTH 80:KEY OFF
20 FILES "*.DOC"
30 LINE INPUT "NAME OF FILE TO TYPE: ";NAM$
35 IF NAM$="" THEN 70
40 IF INSTR(NAM$,".")>0 THEN 60
50 IF LEN(NAM$)<9 THEN NAM$=NAM$+".DOC"
60 OPEN NAM$ FOR INPUT AS #1
70 ON ERROR GOTO 240
80 CLS
90 FOR X=1 TO 2300
100 CO=CO+1
105 IF NAM$="" THEN READ A$:GOTO 120
110 LINE INPUT #1,A$
120 FOR Y=1 TO LEN(A$)
130 B$=MID$(A$,Y,1)
140 IF ASC(B$)=9 THEN PRINT "     ";:GOTO 180
150 PRINT B$;
160 IF B$<>" " THEN SOUND 75,.1
170 IF B$<>" " THEN FOR Z=1 TO 50:NEXT Z
180 NEXT Y
190 FOR Z=1 TO 100:NEXT Z
200 IF CO=>22 THEN LOCATE 25,1:INPUT "PRESS ENTER TO CONTINUE - ";C$:CLS:CO=0
210 PRINT
220 NEXT X
230 GOTO 90
240 LOCATE 25,1:INPUT "PRESS ENTER TO CONTINUE - ";C$:CLS:CLOSE:END
250 '
260 DATA "TELETYPE"
270 DATA "Whether you use this program as an eye catcher or as a fun way to send "
280 DATA "messages, Teletype is an interesting way to get your point across."