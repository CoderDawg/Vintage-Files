10 RESTORE
20 CLS
30 '***** Example of bubble sort and plotting *****
40 KEY OFF
50 CNT% = 99
60 SWP% = 0
70 EXC% = 0
80 PASS = 0
90 DIM X(CNT%), X2(CNT%)
100 RANDOMIZE 10
110 '** FILL ARRAY
120 FOR LCV = 1 TO CNT%
130   X(LCV) = INT(RND(1) * 98 + 1)
140 NEXT
150 '** PRINT UNSORTED ARRAY
160 PRINT "UNSORTED ARRAY:  "
170 FOR LCV =  1 TO CNT%
180   PRINT X(LCV);
190 NEXT
200 PRINT
210 TIME$ = "0"
220 FOR LCV1 = 1 TO CNT% - 1
230   FOR LCV2 = LCV1 + 1  TO CNT%
240     IF X(LCV1) > X(LCV2) THEN GOSUB 650
250     PASS = PASS + 1
260   NEXT
270 NEXT
280 PRINT : PRINT "SORTED ARRAY:  "
290 FOR LCV =  1 TO CNT%
300   PRINT X(LCV);
310 NEXT
320 PRINT
330 PRINT TIME$
340 PRINT
350 PRINT : PRINT "#COMPARISONS:  ";SWP%;"  #EXCHANGES:  ";EXC%;"  #PASSES:  ";PASS
360 PRINT : PRINT
370 '** CLEAR ARRAY
380 FOR LCV = 1 TO 99
390   X(LCV) = 0
400 NEXT
410 RANDOMIZE 10
420 '** FILL ARRAY
430 FOR LCV = 1 TO 99
440   X(LCV) = INT(RND(1) * 98 + 1)
450 NEXT
460 PRINT "UNSORTED ARRAY:  "
470 FOR LCV =  1 TO CNT%
480   PRINT X(LCV);
490 NEXT
500 PRINT
510 TIME$ = "0"
520 FOR LCV = 1 TO 99
530 TEMP = X(LCV)
540 X2(TEMP) = TEMP
560 NEXT
570 PRINT : PRINT "SORTED ARRAY:  "
580 FOR LCV =  1 TO CNT%
590   IF X2(LCV) <> 0 THEN PRINT X2(LCV);
600 NEXT
610 PRINT
620 PRINT TIME$
630 '
640 END
650  ' TEMP = X(LCV1)
660  ' X(LCV1) = X(LCV2)
670  ' X(LCV2) = TEMP
680 SWP% = SWP% + 1
690 SWAP X(LCV2),X(LCV1)
700 RETURN
710 END