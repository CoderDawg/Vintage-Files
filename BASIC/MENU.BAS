10 KEY OFF:SCREEN 0,0,0:COLOR 7,0:LOCATE ,,,7
20 DEF SEG
30 SUBRT$=STRING$(159,32)
40 SUBLC%=VARPTR(SUBRT$)
50 GOSUB 340
60 BLOAD"DIRECTRY",DIRECT
70 DIM L$(111),STACK(14)
80 FCB$=STRING$(33,32)
90 DTA$=STRING$(33,32)
100 FILLER$=STRING$(12,32)
110 COUNT%=0
120 FOR LOOP%=0 TO 111:L$(LOOP%)=FILLER$:NEXT
130 CLS
140 LOCATE 1,20
150 PRINT"*** DIRECTORY ALPHABETIZER AND SELECTOR ***"
160 LOCATE 3,10,1
170 PRINT"Specify drive letter for directory (A B C D): ";
180 GOSUB 360:DRV$=KY$
190 IF INSTR("abcd",DRV$)>0 THEN DRV$=CHR$(ASC(DRV$)-32)
200 HIT%=INSTR("ABCD",DRV$)
210 IF HIT%=0 THEN SOUND 50,7:GOTO 160 ELSE PRINT DRV$
220 CALL DIRECT(DRV$,FCB$,DTA$,L$(0),COUNT%)
230 LOCATE 5,10
240 PRINT "Directory on drive "DRV$": contains"COUNT%"entries"
250 PRINT
260 GOSUB 490
270 COLOR 7
280 GOSUB 730
290 BEEP
300 LOCATE 25,1:PRINT"SELECT COLUMN NUMBER: ";
310 GOSUB 360:CN$=KY$
320 CN=VAL(CN$):IF CN<1 OR CN>5 THEN 310 ELSE LOCATE 25,1:PRINT SPACE$(25);
330 GOTO 380
340 DIRECT=PEEK(SUBLC%+1)+PEEK(SUBLC%+2)*256
350 RETURN
360 KY$=INPUT$(1)
370 RETURN
380 XLOC=(CN-1)*15+8:LOCATE 1,XLOC:COLOR 31:PRINT CN:COLOR 7
390 BEEP:LOCATE 25,1:PRINT"SELECT ROW LETTER: ";
400 GOSUB 360
410 RN=ASC(KY$):IF RN>96 AND RN<123 THEN RN=RN-32
420 RN=RN-62:IF RN>22 OR RN<3 THEN 400
430 LOCATE RN,1:COLOR 21-(RN/2=INT(RN/2))*10:PRINT CHR$(62+RN)">"
440 LOCATE 25,1:PRINT SPACE$(25);
450 LOOP=(CN-1)*20+RN-2:LOCATE RN,XLOC-4:COLOR 21-(RN/2=INT(RN/2))*10
460 IF ASC(L$(LOOP))=32 THEN 270
470 PRINT L$(LOOP):COLOR 7:LOCATE ,,,0
480 GOTO 860
490 COLOR 21:LOCATE 10,20:PRINT"Alphabetizing...";
500 N=COUNT%
510 TOP=0 : LOW=0 : HIGH=N
520 WHILE 1
530   WHILE LOW<HIGH
540     IF HIGH-LOW>1 THEN GOTO 560    'Small partition?
550     IF L$(LOW)>L$(HIGH) THEN SWAP L$(LOW),L$(HIGH):GOTO 620 ELSE 620
560     J=HIGH+1 : GOSUB 650    ' Partition
570     IF J-LOW >= HIGH-J THEN GOTO 590  ' Stack larger subproblem
580       STACK(TOP+1)=J+1 : STACK(TOP+2)=HIGH : HIGH=J-1 : GOTO 600
590       STACK(TOP+1)=LOW : STACK(TOP+2)=J-1  : LOW=J+1
600     TOP=TOP+2
610   WEND
620   IF TOP=0 THEN RETURN
630   HIGH=STACK(TOP) : LOW=STACK(TOP-1) : TOP=TOP-2 'Unstack prob.
640 WEND
650 ' Partition routine  - Uses LOW and J, returns J
660 PIVOT$=L$(LOW) : I=LOW         'Choose pivot element
670 WHILE 1      'Loop forever
680   I=I+1 : IF L$(I)<PIVOT$ AND I<HIGH THEN GOTO 680 'Scan upward
690   J=J-1 : IF L$(J)>PIVOT$ THEN GOTO 690          'Scan downward
700   IF I<J THEN SWAP L$(I),L$(J) ELSE GOTO 720     'Pointers met?
710 WEND
720 SWAP L$(LOW),L$(J) : RETURN    'J is position for pivot
730 CLS:FOR YLOC=3 TO 22:LOCATE YLOC,1:PRINT CHR$(62+YLOC)">"
740 IF YLOC/2=INT(YLOC/2) THEN COLOR 7 ELSE COLOR 15
750 NEXT YLOC
760 COLOR 7,0
770 FOR XLOC=8 TO 68 STEP 15:LOCATE 1,XLOC:PRINT (XLOC-8)/15+1
780 NEXT XLOC
790 FOR LOOP=0 TO COUNT%-1
800 LOCATE (LOOP MOD 20)+3,INT(LOOP/20)*15+4
810 IF LOOP/2=INT(LOOP/2) THEN COLOR 7 ELSE COLOR 15
820 PRINT L$(LOOP+1)
830 NEXT LOOP
840 COLOR 7,0
850 RETURN
860 FOR I=1 TO 500:NEXT I
870 COLOR 7,0:CLS:LOCATE ,,,7
880 RUN DRV$+":"+L$(LOOP)
890 END