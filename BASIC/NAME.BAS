100 RESTORE : WIDTH 80 : COLOR 15,0 : CLEAR : CLS
1000 DIM D$(2)
1010 INPUT "PLEASE ENTER THE NUMBER OF NAME TO BE GENERATED";LCV3
1015 PRINT : PRINT "WHERE DO YOU WANT YOUR OUTPUT (P)rinter or (S)creen?";
1016 A$ = INPUT$(1)
1017 IF A$ = "P" OR A$ = "p" THEN OUTPUT% = 1 ELSE OUTPUT% = 0
1018 CLS
1020 RANDOMIZE VAL(RIGHT$(TIME$,2))+INT(RND(1)*4000)
1030 FOR I1 = 1 TO LCV3
1040 RESTORE
1050 NUM = 77
1060 NUM2 = 105
1070 RAN = INT (RND * (NUM) + 1)
1080 FOR LCV = 1 TO NUM
1090     READ A$
1100 IF LCV = RAN THEN B$ = A$
1110 NEXT
1120 RAN = INT (RND * (NUM2) + 1)
1130 RAN2 = INT (RND * (NUM2) + 1)
1140 FOR LCV = 1 TO NUM2
1150 READ C$
1160 IF LCV = RAN THEN D$(1) = C$
1170 IF LCV = RAN2 THEN D$(2) = C$
1180 NEXT
1190 PRINT "FIRST NAME:  ";B$
1200 PRINT "LAST NAME:   ";D$(1)+D$(2)
1210 PRINT
1215 IF OUTPUT% = 1 THEN GOSUB 5000
