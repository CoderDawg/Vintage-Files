100 REM DMVQUIZ.BAS - RANDOMIZED DMV QUIZ
110 DEFINT A-Z
120 STRLEN% = 40
130 CR$ = CHR$(13)
140 RANDOMIZE TIMER
150 MAXQ = 500
160 DIM Q$(MAXQ)
170 DIM A$(MAXQ,4)
180 DIM C$(MAXQ)
190 DIM F$(6)
200 DIM U(MAXQ)
210 DIM P(4)
220 DIM S$(4)
230 CLS
240 PRINT "THE DMV QUIZ"
250 PRINT "Loading questions..."
260 ON ERROR GOTO 1680
270 OPEN "DMVQUIZ.TXT" FOR INPUT AS #1
280 ON ERROR GOTO 0
290 QC = 0
300 IF EOF(1) THEN GOTO 400
310 LINE INPUT #1, LN$
320 GOSUB 930
330 LOCATE 5,1
340 IF OK = 0 THEN PRINT "Bad line skipped": GOTO 300
350 QC = QC + 1
360 LOCATE 4,1 
370 PRINT USING "Number of questions loaded: ####";QC;
380 GOSUB 1180
390 GOTO 300
400 CLOSE #1
410 PRINT
420 IF QC = 0 THEN PRINT "No questions found.": END
430 CLS
440 PRINT "THE DMV QUIZ"
450 PRINT
460 PRINT "Based on,"
470 PRINT "The California Department of Motor Vehicle"
480 PRINT "Rules and Regulations Handbook"
490 PRINT
500 PRINT "1) Learning mode"
510 PRINT "2) Test mode"
520 PRINT
530 INPUT "Select mode"; MD$
540 IF MD$ <> "1" AND MD$ <> "2" THEN GOTO 430
550 CLS
560 SC = 0
570 WR = 0
580 FOR QQ = 1 TO QC
590 GOSUB 1260
600 CLS
610 REM LIMIT LINE LENGTH OF QUESTION AND SPLIT AT SPACES
620 T$ = Q$(QN)
630 GOSUB 1540
640 PRINT "Question ";QQ;" of ";QC
650 PRINT
660 PRINT W$
670 PRINT
680 PRINT "A) ";S$(1)
690 PRINT "B) ";S$(2)
700 PRINT "C) ";S$(3)
710 PRINT "D) ";S$(4)
720 PRINT
730 INPUT "Answer A-D or Q to quit"; AN$
740 IF AN$ = "" THEN GOTO 730
750 AN$ = LEFT$(AN$,1)
760 IF ASC(AN$) >= 97 AND ASC(AN$) <= 122 THEN AN$ = CHR$(ASC(AN$)-32)
770 IF AN$ = "Q" THEN GOTO 830
780 IF AN$ < "A" OR AN$ > "D" THEN PRINT "Enter A, B, C, or D": GOTO 730
790 IF AN$ = NC$ THEN SC = SC + 1 ELSE WR = WR + 1
800 IF MD$ = "1" THEN GOSUB 1480
810 IF MD$ = "1" THEN INPUT "Press ENTER for next question"; Z$
820 NEXT QQ
830 CLS
840 PRINT "QUIZ COMPLETE"
850 PRINT
860 PRINT "Questions Answered: ";SC + WR
870 PRINT "Correct:            ";SC
880 PRINT "Wrong:              ";WR
890 IF SC + WR > 0 THEN PRINT "Score:              ";INT((SC * 100) / (SC + WR)); "%"
900 PRINT
910 PRINT "Done."
920 END
930 REM PARSE CSV LINE
940 OK = 0
950 NF = 0
960 PX = 1
970 L = LEN(LN$)
980 IF PX > L THEN GOTO 1130
990 IF MID$(LN$,PX,1) <> CHR$(34) THEN RETURN
1000 PX = PX + 1
1010 NF = NF + 1
1020 IF NF > 6 THEN RETURN
1030 F$(NF) = ""
1040 IF PX > L THEN RETURN
1050 CH$ = MID$(LN$,PX,1)
1060 IF CH$ = CHR$(34) THEN GOTO 1100
1070 F$(NF) = F$(NF) + CH$
1080 PX = PX + 1
1090 GOTO 1040
1100 PX = PX + 1
1110 IF PX > L THEN GOTO 1130
1120 IF MID$(LN$,PX,1) <> "," THEN RETURN ELSE PX = PX + 1: GOTO 980
1130 IF NF <> 6 THEN RETURN
1140 IF LEN(F$(1)) <> 1 THEN RETURN
1150 IF F$(1) < "A" OR F$(1) > "D" THEN RETURN
1160 OK = 1
1170 RETURN
1180 REM STORE QUESTION
1190 Q$(QC) = F$(2)
1200 A$(QC,1) = F$(3)
1210 A$(QC,2) = F$(4)
1220 A$(QC,3) = F$(5)
1230 A$(QC,4) = F$(6)
1240 C$(QC) = F$(1)
1250 RETURN
1260 REM PICK RANDOM UNUSED QUESTION
1270 QN = INT(RND * QC) + 1
1280 IF U(QN) = 1 THEN GOTO 1270
1290 U(QN) = 1
1300 FOR I = 1 TO 4
1310 P(I) = I
1320 NEXT I
1330 REM SHUFFLE ANSWERS
1340 FOR I = 1 TO 4
1350 J = INT(RND * 4) + 1
1360 T = P(I)
1370 P(I) = P(J)
1380 P(J) = T
1390 NEXT I
1400 FOR I = 1 TO 4
1410 S$(I) = A$(QN,P(I))
1420 NEXT I
1430 CO = ASC(C$(QN)) - 64
1440 FOR I = 1 TO 4
1450 IF P(I) = CO THEN NC$ = CHR$(64 + I)
1460 NEXT I
1470 RETURN
1480 REM LEARNING MODE FEEDBACK
1490 PRINT
1500 IF AN$ = NC$ THEN PRINT "Correct!": RETURN
1510 PRINT "Incorrect."
1520 PRINT "Correct answer is ";NC$
1530 RETURN
1540 REM WORD WRAP T$ INTO W$ USING STRLEN%
1550 W$ = ""
1560 S$ = T$
1570 IF LEN(S$) <= STRLEN% THEN W$ = W$ + S$: RETURN
1580 P% = 0
1590 FOR I% = STRLEN% TO 1 STEP -1
1600 IF MID$(S$, I%, 1) = " " THEN P% = I%: I% = 0
1610 NEXT I%
1620 IF P% = 0 THEN P% = STRLEN%
1630 W$ = W$ + LEFT$(S$, P%) + CR$
1640 IF MID$(S$, P%, 1) = " " THEN S$ = MID$(S$, P% + 1) ELSE S$ = MID$(S$, P% + 1)
1650 IF LEN(S$) > STRLEN% THEN GOTO 1580
1660 W$ = W$ + S$
1670 RETURN
1680 CLS
1690 PRINT "Could not open DMVQUIZ.TXT"
1700 PRINT "Make sure the file exists."
1710 END
