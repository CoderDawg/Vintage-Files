10 ON ERROR GOTO 280
20 BLOAD"A:DISKHNDL.BIN"
30 BLOAD"B:DISKHNDL.BIN"
40 CLS:KEY OFF:SCREEN 0,0,0
50 DEF SEG=&H1700
60 DP$=SPACE$(1)
70 REM ***** CD%=OPTION (1=CHECK DEFAULT DRIVE, 2=CHANGE DEFAULT DRIVE)
80 REM ***** DP$=DRIVE SPEC. (A FOR DRIVE A:, B FOR DRIVE B:, ETC)
90 LOCATE 8,23:PRINT"THE GREAT DISK UTILITY"
100 COLOR 7,0:LOCATE 11,30:PRINT "OPTIONS:"
110 LOCATE 12,22:PRINT "(1) CHECK DEFAULT DRIVE"
120 LOCATE 13,22:PRINT "(2) CHANGE DEFAULT DRIVE"
130 LOCATE 14,22:PRINT "(3) FILES ON DEFAULT DRIVE"
140 LOCATE 15,22:PRINT "(4) EXIT PROGRAM"
150 A$=INPUT$(1)
160 CD%=VAL(A$):IF CD%<1 OR CD%>4 THEN GOTO 150
170 LOCATE 11,38:PRINT CD%
180 IF CD%=1 THEN LOCATE 12,22:COLOR 31:PRINT "(1) CHECK DEFAULT DRIVE":COLOR 7
190 IF CD%=2 THEN LOCATE 13,22:COLOR 31:PRINT "(2) CHANGE DEFAULT DRIVE":COLOR 7:LOCATE 16,19:PRINT "ENTER NEW DRIVE (A OR B): ";:DP$=INPUT$(1):LOCATE 16,18:PRINT SPACE$(60)
200 IF CD%=3 THEN LOCATE 14,22:COLOR 31:PRINT "(3) FILES ON DEFAULT DRIVE":COLOR 7:LOCATE 17,1:FILES:CD%=1
210 IF CD%=4 THEN LOCATE 15,22:COLOR 15:PRINT "(4) EXIT PROGRAM":COLOR 7:GOTO 270
220 FOR PP=1 TO 1000:NEXT PP
230 IF DP$="a" THEN DP$="A" ELSE IF DP$="b" THEN DP$="B"
240 CALL DISK(CD%,DP$)
250 LOCATE 16,25:PRINT "DEFAULT DRIVE IS: ";DP$
260 FOR P=1 TO 3000:NEXT:GOTO 40
270 LOCATE 20,1:END
280 IF ERR=53 THEN RESUME NEXT ELSE PRINT "ERROR"ERR"ON LINE"ERL". PLEASE FIX."
290 ON ERROR GOTO 0:END