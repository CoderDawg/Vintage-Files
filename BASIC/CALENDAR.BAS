10 CLS
20 N=0
30 SO=0
40 LO=0
50 M1=7
60 M2=7
70 M4=1
80 PRINT "DO YOU WANT YOUR CALENDAR ON THE (P)RINTER OR THE (S)CREEN ";
90 QQ$=INPUT$(1)
100 IF QQ$="S" OR QQ$="s" THEN OP$="SCRN:":GOTO 130
110 IF QQ$="P" OR QQ$="p" THEN OP$="LPT1:":GOTO 130
120 GOTO 90
130 DIM DO$(7),NO(12),MO$(12)
135 OPEN OP$ FOR OUTPUT AS #1
140 READ DO$(1),DO$(2),DO$(3),DO$(4),DO$(5),DO$(6),DO$(7)
150 FOR I=1 TO 12
160 READ MO$(I),NO(I)
170 NEXT
180 PRINT "ENTER THE FIRST MONTH AND YEAR TO BE PRINTED (IE. JAN,1982)";
190 INPUT M$,Y1
200 GOSUB 1180
210 PRINT "ENTER THE NUMBER OF MONTHS TO BE PRINTED (IE.10)";
220 INPUT N
230 PRINT "DO YOU WANT PAGE ALIGNMENT (Y-N)";
240 INPUT A1$
250 IF A1$<>"Y" THEN 280
260 PRINT "BEFORE THE PRINTING OF EACH MONTH A `?' WILL APPEAR"
270 PRINT "ALIGN TO THE TOP OF THE PAGE (CONTROL-HOME) BEFORE HITTING RETURN."
280 FOR I=1 TO 12
290 IF M$<>MO$(I) THEN 310
300 M4=I
310 NEXT I
320 FOR K=1 TO 7
330 IF D1$<>DO$(K) THEN 350
340 SO=K
350 NEXT K
360 REM
370 FOR I2=M4 TO M4+N-1
380 NO(2)=28
390 Y=Y1
400 IF INT(Y/4) <> Y/4 THEN 420
410 NO(2)=29
420 IO=0
430 M3=I2
440 IF M3<=12 THEN 500
450 M3=M3-12
460 Y=Y1+1
470 IF INT(Y/4)<>Y/4 THEN 490
480 NO(2)=29
490 GOTO 440
500 IF SO=0 THEN 610
510 GOSUB 650
520 FOR J=1 TO M2
530 GOSUB 750
540 IF NO(M3) < IO THEN 600
550 GOSUB 810
560 GOSUB 1070
570 GOSUB 1070
580 LO=LO+1
590 NEXT J
600 REM
610 IF SO<>8 THEN 630
620 SO=1
630 NEXT I2
640 END
650 REM
660 IF A1$ <>"Y" THEN 680
670 INPUT "HIT RETURN";X$
680  PRINT
690 PRINT #1, TAB(32);MO$(M3);" ";Y
700 FOR I=1 TO 7
710 PRINT #1, "     ";DO$(I);"  ";
720 NEXT I
730 PRINT #1,CHR$(13)
740 RETURN
750 REM SCHEDULE
760 FOR I=1 TO M1
770 PRINT #1, "I---------";
780 NEXT I
790 PRINT #1, "I"
800 RETURN
810 REM DAY LINE
820 FOR I=1 TO M1
830 IF J<>1 THEN 860
840 IF I<>SO THEN 860
850 IO=1
860 IF NO(M3) >= IO THEN 900
870 PRINT #1, "I         ";
880 IO=IO+1
890 GOTO 1020
900 IF IO>9 THEN 980
910 IF IO <> 0 THEN 940
920 PRINT #1, "I         ";
930 GOTO 1020
940 PRINT #1, "I   ";IO;"   ";
950 IO=IO+1
960 S1=I+1
970 GOTO 1020
980 PRINT #1, "I  ";IO;"   ";
990 S1=I+1
1000 IO=IO+1
1010 SO=I+1
1020 NEXT I
1030 PRINT #1, "I"
1040 LO=0
1050 SO=S1
1060 RETURN
1070 REM
1080 FOR I=1 TO M1
1090 PRINT #1, "I         ";
1100 NEXT I
1110 PRINT #1, "I"
1120 RETURN
1130 REM DATA
1140 DATA SUN,MON,TUE,WED,THU,FRI,SAT
1150 DATA JAN,31,FEB,28,MAR,31,APR,30,MAY,31,JUN,30
1160 DATA JUL,31,AUG,31,SEP,30,OCT,31,NOV,30,DEC,31
1170 REM
1180 J$(1)="SUN"
1190 J$(2)="MON"
1200 J$(3)="TUE"
1210 J$(4)="WED"
1220 J$(5)="THU"
1230 J$(6)="FRI"
1240 J$(7)="SAT"
1250 D=1 : Y=Y1
1260 IF M$="JAN" THEN M=1
1270 IF M$="FEB" THEN M=2
1280 IF M$="MAR" THEN M=3
1290 IF M$="APR" THEN M=4
1300 IF M$="MAY" THEN M=5
1310 IF M$="JUN" THEN M=6
1320 IF M$="JUL" THEN M=7
1330 IF M$="AUG" THEN M=8
1340 IF M$="SEP" THEN M=9
1350 IF M$="OCT" THEN M=10
1360 IF M$="NOV" THEN M=11
1370 IF M$="DEC" THEN M=12
1380 K=INT(.6+(1/M))
1390 L=Y-K
1400 O=M+12*K
1410 P=L/100
1420 Z1=INT(P/4)
1430 Z2=INT(P)
1440 Z3=INT((5*L)/4)
1450 Z4=INT(13*(O+1)/5)
1460 Z=Z4+Z3-Z2+Z1+D-1
1470 Z=Z-(7*INT(Z/7))+1
1480 D1$=J$(Z)
1490 RETURN